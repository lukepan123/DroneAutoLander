<launch>
	<!-- MAVROS for the ground-station "go to position" start-up (goto_stack.sh).
	     apm_config_goto.yaml (stock apm_config.yaml with a wider time-sync RTT limit), trimmed plugin list (mavros_pluginlists.yaml beside
	     this file). The FC is reached through wfb-ng's local MAVLink TCP proxy,
	     which owns the UART on this drone. -->
	<arg name="fcu_url" default="tcp://127.0.0.1:5760" />
	<arg name="pluginlists" />   <!-- absolute path, passed by goto_stack.sh -->
	<arg name="config" />        <!-- absolute path, passed by goto_stack.sh -->
	<arg name="gcs_url" default="" />
	<arg name="tgt_system" default="1" />
	<arg name="tgt_component" default="1" />
	<arg name="fcu_protocol" default="v2.0" />
	<arg name="respawn_mavros" default="true" />
	<arg name="namespace" default="mavros"/>
	<include file="$(find-pkg-share mavros)/launch/node.launch">
		<arg name="pluginlists_yaml" value="$(var pluginlists)" />
		<arg name="config_yaml" value="$(var config)" />
		<arg name="fcu_url" value="$(var fcu_url)" />
		<arg name="gcs_url" value="$(var gcs_url)" />
		<arg name="tgt_system" value="$(var tgt_system)" />
		<arg name="tgt_component" value="$(var tgt_component)" />
		<arg name="fcu_protocol" value="$(var fcu_protocol)" />
		<arg name="respawn_mavros" value="$(var respawn_mavros)" />
		<arg name="namespace" value="$(var namespace)"/>
	</include>
</launch>
