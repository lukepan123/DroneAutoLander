    <joint name="steering_joint" type="revolute">
      <pose>-0.002 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>steering_wheel</child>
      <axis>
        <xyz>0 0.964095 0.265556</xyz>
        <limit>
          <lower>-7.85</lower>
          <upper>7.85</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <cfm_damping>1</cfm_damping>
        </ode>
      </physics>
    </joint>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_separation>1.572</wheel_separation>
      <kingpin_width>1.52</kingpin_width>
      <wheel_base>2.86</wheel_base>
      <wheel_radius>0.31265</wheel_radius>
      <steering_limit>0.8727</steering_limit>
      <min_velocity>-20.0</min_velocity>
      <max_velocity>20.0</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
      <steer_p_gain>3.0</steer_p_gain>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_rover_vel</topic>
      <odom_topic>/prius_hybrid/ackermann_odom</odom_topic>
      <tf_topic>/prius_hybrid/ackermann_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
    <plugin name="gz::sim::systems::OdometryPublisher"
            filename="gz-sim-odometry-publisher-system">
      <!-- Ground-truth / world pose; direct wheel mounting removes rear axle pitch DOF. -->
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/landing_pad/odom</odom_topic>
      <tf_topic>/landing_pad/tf_truth</tf_topic>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>

